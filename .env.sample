# Defaults from config-dist/settings.php.
# install-formr.sh --env-file env.sample writes these onto existing settings.
# It does not add keys. true/false and null are written as those PHP values.
#
# A few settings are omitted because their keys cannot be named here:
# content_settings (colon keys), allowed_file_endings_for_run_upload (slash keys),
# 2fa (a name cannot start with a digit), curl (CURLOPT_* constant keys),
# and list values: referrer_codes, reserved_run_names, maintenance_ips,
# disabled_features, email.queue_skip_accounts, email.smtp_options,
# email_subscriptions labels such as "+1 week".

# Use subdomains for studies
USE_STUDY_SUBDOMAINS=true
ADMIN_DOMAIN="example.com"
STUDY_DOMAIN="*.example.com"
API_DOMAIN=""
PROTOCOL="https://"

# Timezone
TIMEZONE="Europe/Berlin"

# Database
DATABASE_DATASOURCE="Database/Mysql"
DATABASE_PERSISTENT=false
DATABASE_HOST="127.0.0.1"
DATABASE_LOGIN="formr"
DATABASE_PASSWORD="password"
DATABASE_DATABASE="formr"
DATABASE_PORT=3306
DATABASE_PREFIX=""
DATABASE_ENCODING="utf8mb4"
DATABASE_UNIX_SOCKET=""

# OpenCPU
OPENCPU_INSTANCE_LOCAL_URL="https://opencpu.example.com"
OPENCPU_INSTANCE_PUBLIC_URL="https://opencpu.example.com"
OPENCPU_INSTANCE_R_LIB_PATH="/usr/local/lib/R/site-library"
ALTERNATIVE_OPENCPU_INSTANCE_LOCAL_URL="https://opencpu.example.com"
ALTERNATIVE_OPENCPU_INSTANCE_PUBLIC_URL="https://opencpu.example.com"
ALTERNATIVE_OPENCPU_INSTANCE_R_LIB_PATH="/usr/local/lib/R/site-library"

# Empty falls back to api_base_url()
API_INTERNAL_URL=""
R_FIDDLE_URL="https://fiddle.rforms.org/"

# Email sent by the formr app
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_TLS=true
EMAIL_FROM="email@example.com"
EMAIL_FROM_NAME="Formr"
EMAIL_USERNAME="email@example.com"
EMAIL_PASSWORD="password"
EMAIL_USE_QUEUE=true
EMAIL_QUEUE_LOOP_INTERVAL=1200
EMAIL_QUEUE_ITEM_TTL=1200
EMAIL_QUEUE_ITEM_TRIES=4

# Email sent by study admins

DISPLAY_ERRORS_WHEN_LIVE=0
DISPLAY_ERRORS=0
ERROR_TO_STDERR=0

# Email rate limits
EMAIL_THRESHOLDS_IN_LAST_1M=1
EMAIL_THRESHOLDS_IN_LAST_1M_TESTING=3
EMAIL_THRESHOLDS_IN_LAST_10M=2
EMAIL_THRESHOLDS_IN_LAST_10M_TESTING=10
EMAIL_THRESHOLDS_IN_LAST_1H=4
EMAIL_THRESHOLDS_IN_LAST_1H_TESTING=10
EMAIL_THRESHOLDS_IN_LAST_1D=10
EMAIL_THRESHOLDS_IN_LAST_1D_TESTING=100
EMAIL_THRESHOLDS_IN_LAST_1W=60

USER_CODE_REGULAR_EXPRESSION="/^[A-Za-z0-9+-_~]{64}$/"

# Session expiry in seconds. config-dist writes these as expressions.
# 365 * 24 * 60 * 60
EXPIRE_UNREGISTERED_SESSION=31536000
# 7 * 24 * 30 * 60
EXPIRE_REGISTERED_SESSION=302400
# 7 * 24 * 30 * 60
EXPIRE_ADMIN_SESSION=302400
# max() of the three expire settings above
SESSION_COOKIE_LIFETIME=31536000

ADMIN_MAXIMUM_SIZE_OF_UPLOADED_FILES=50

# These stay as APPLICATION_ROOT concatenations unless you set a full path.
# RUN_EXPORTS_DIR="/path/to/documentation/run_components"
# SURVEY_UPLOAD_DIR="/path/to/tmp/backups/surveys"
# WEB_DIR="/path/to/webroot"

# Cron, in minutes
CRON_TTL_CRON=15
CRON_TTL_LOCKFILE=30
CRON_INTERCEPT_IF_EXPIRED=false

# Social share buttons
SOCIAL_SHARE_FACEBOOK_URL="https://www.facebook.com/sharer.php?u=%{url}&t=%{title}"
SOCIAL_SHARE_FACEBOOK_TARGET="_blank"
SOCIAL_SHARE_FACEBOOK_WIDTH=300
SOCIAL_SHARE_FACEBOOK_HEIGHT=400
SOCIAL_SHARE_TWITTER_URL="https://twitter.com/share?url=%{url}&text=%{title}"
SOCIAL_SHARE_TWITTER_TARGET="_blank"
SOCIAL_SHARE_TWITTER_WIDTH=300
SOCIAL_SHARE_TWITTER_HEIGHT=400

# OSF API
OSF_CLIENT_ID="xxxxxxxxx"
OSF_CLIENT_SECRET="xxxxxxx-secret"
OSF_REDIRECT_URL="https://formr.org/api/osf"
OSF_SCOPE="osf.full_write"
OSF_TOKEN_URI="https://accounts.osf.io/oauth2/token"
OSF_AUTHORIZATION_URI="https://accounts.osf.io/oauth2/authorize"
OSF_API="https://api.osf.io/v2"
OSF_SITE_URL="https://osf.io/myprojects/"

# Email subscription choices. Relative labels such as "+1 week" stay in settings.php.
EMAIL_SUBSCRIPTIONS_1="Subscribe to E-mails"
EMAIL_SUBSCRIPTIONS_0="Never receive emails"

ALLOWED_EMPTY_PAGES=100

# Run unit session queue
UNIT_SESSION_QUEUE_EXPIRATION_EXTENSION="+10 minutes"
UNIT_SESSION_USE_QUEUE=true
UNIT_SESSION_DEBUG=false

# Memory limits
MEMORY_LIMIT_RUN_GET_DATA="1024M"
MEMORY_LIMIT_RUN_IMPORT_UNITS="256M"
MEMORY_LIMIT_SPR_OBJECT_ARRAY="1024M"
MEMORY_LIMIT_SPR_SHEETS_ARRAY="1024M"
MEMORY_LIMIT_SURVEY_GET_RESULTS="2048M"
MEMORY_LIMIT_SURVEY_UPLOAD_ITEMS="256M"

# Empty uses {APPLICATION_ROOT}/formr-crypto.key
ENCRYPTION_KEY_FILE=null
USE_XSENDFILE=true
IN_MAINTENANCE=false

BRAND="<span>f</span>orm<span>{`r}</span>"
BRAND_LONG="<b>formr</b> survey framework"

COPY_CONTEXT_SSL_VERIFY_PEER=false
COPY_CONTEXT_SSL_VERIFY_PEER_NAME=false

# Run session lock timeout, in seconds
RUN_SESSION_LOCK_TIMEOUT_QUEUE=0.1
RUN_SESSION_LOCK_TIMEOUT_USER=10.0

# Maximum study-data retention, in months. INF means no maximum.
KEEP_STUDY_DATA_FOR_MONTHS_MAXIMUM=84

NOTIFICATION_DEFAULT_THROTTLE_MINUTES=10
NOTIFICATION_THROTTLE_MAP_ERROR=10
NOTIFICATION_THROTTLE_MAP_WARNING=10
NOTIFICATION_THROTTLE_MAP_INFO=10
